# Variables de entorno — copiar a .env y completar.
# NUNCA subir .env al repositorio (está en .gitignore).

# ─── Base de datos ───────────────────────────────────────────────────────────
# Contraseña del Postgres del VPS (docker-compose arma DATABASE_URL con ella).
# Generar con:  openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=REEMPLAZAR

# Solo para desarrollo local sin Docker (en Docker lo fija docker-compose.yml):
# DATABASE_URL=postgres://holy:REEMPLAZAR@localhost:5432/holy

# ─── Sesiones ────────────────────────────────────────────────────────────────
# Clave para firmar los JWT (mínimo 32 caracteres). Cambiarla cierra todas
# las sesiones. Generar con:  openssl rand -hex 32
JWT_SECRET=REEMPLAZAR_CON_64_CARACTERES_HEX
# Duración de la sesión en horas (por defecto 168 = 7 días)
JWT_EXPIRES_HOURS=168

# ─── Servidor ────────────────────────────────────────────────────────────────
# Origen permitido por CORS (el dominio público). Vacío → '*'.
CORS_ORIGIN=https://midominio.com
# Tamaño máximo del cuerpo en /api/* y de cada imagen (MB)
MAX_BODY_MB=25
MAX_IMAGE_MB=15
# Carpeta de fotos (en Docker: /data/uploads, volumen holy-uploads)
# UPLOADS_DIR=./uploads

# ─── Administrador maestro (solo scripts/create-admin.js) ───────────────────
# La aplicación no puede crear administradores: este script es el único
# camino para dar de alta o recuperar un admin. Ver src/js/roles.js.
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=REEMPLAZAR_MINIMO_8_CARACTERES
ADMIN_NOMBRE=Administrador
