# Archivo de variables de entorno para desarrollo local
# NUNCA subir este archivo al repositorio (está en .gitignore)
#
# Cómo obtener estos valores:
# 1. Ve a supabase.com → tu proyecto → Settings → API
# 2. SUPABASE_URL      = "Project URL"
# 3. SUPABASE_ANON_KEY = "anon public" key
# 4. SUPABASE_SERVICE_KEY = "service_role" key  ⚠️ MANTENER PRIVADA
#
# Administrador maestro (solo para scripts/create-admin.js):
#   ADMIN_EMAIL      = correo del admin maestro
#   ADMIN_PASSWORD   = contraseña inicial  ⚠️ MANTENER PRIVADA (mín. 8 caracteres)
#   ADMIN_NOMBRE     = nombre mostrado en la app (opcional)
#
# La aplicación no puede crear administradores, así que este script es el
# único camino para dar de alta o recuperar un admin. Ver src/js/roles.js.

SUPABASE_URL=https://REEMPLAZAR.supabase.co
SUPABASE_ANON_KEY=eyJREEMPLAZAR
SUPABASE_SERVICE_KEY=eyJREEMPLAZAR_SERVICE

ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=REEMPLAZAR_MINIMO_8_CARACTERES
ADMIN_NOMBRE=Administrador
